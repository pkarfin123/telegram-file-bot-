# এই ফাইলের নাম বদলে .env করবেন। আসল .env কখনও GitHub-এ দেবেন না।

# BotFather থেকে পাওয়া টোকেন
BOT_TOKEN=9152060159:AAHCCb6fcmkdbwr3QA5cM9O3H_j3nsfQn-M

# আপনার Telegram সংখ্যাসূচক ID (@userinfobot থেকে পাবেন)
ADMIN_ID=6838643466

# স্থায়ী ডেটা ফোল্ডার (ডাটাবেস, ফাইল, ব্যাকআপ এখানে থাকবে)
DATA_DIR=./data

# সর্বোচ্চ ফাইল সাইজ MB-তে (Telegram বট সর্বোচ্চ 20MB ডাউনলোড করতে পারে)
MAX_FILE_MB=20

# কতগুলো ব্যাকআপ রাখবে
BACKUP_KEEP=14

# ঐচ্ছিক: প্রাইভেট Google Sheet এর জন্য Service Account JSON ফাইলের পথ
GOOGLE_SERVICE_ACCOUNT_FILE=

LOG_LEVEL=INFO
